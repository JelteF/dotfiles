[user]
	name = Jelte Fennema-Nio
	email = github-tech@jeltef.nl
	signingKey = ssh-rsa  id_rsa_3072
[auto]
	color = true
[ui]
	color = auto
[color]
	ui = true
	diff = auto
	status = auto
	branch = auto
[core]
	excludesfile = ~/dotfiles/git/gitignore_global
	editor = nvim
    pager = delta
    whitespace = tabwidth=4
	fsmonitor = true
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[push]
	default = current
	autoSetupRemote = true
    # followTags = true
[help]
    autocorrect = 1

[interactive]
    diffFilter = delta --color-only

[include]
	path = ~/dotfiles/git/catppuccin/catppuccin.gitconfig

[delta]
    features = catppuccin-mocha decorations
    whitespace-error-style = 22 reverse
    side-by-side = false
    line-numbers = false
	navigate = true

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none

[status]
    showUntrackedFiles = normal

[alias]
    track = "!f(){ branch=$(git rev-parse --abbrev-ref HEAD); remote=$(git config remote.pushdefault || echo origin) cmd=\"git branch $branch --set-upstream-to=${1:-$remote}/${2:-$branch}\"; echo $cmd; $cmd; }; f"
    wdiff = diff --color-words
    get = "!git stash && git pull --rebase && git stash pop"
    pr = pull-request
    npr = pull-request
    reset-remote = "!git reset $(git rev-parse --abbrev-ref --symbolic-full-name @{u}) --hard"
    reset-origin = "!git reset origin/$(git rev-parse --abbrev-ref HEAD) --hard"
	tags = tag --format='%(creatordate:short)%09%(objectname:short)%09%(refname:strip=2)%09%(contents:subject)' --sort=creatordate
    checkout-default = "!git checkout $(git rev-parse --abbrev-ref origin/HEAD | sed 's@^origin/@@')"
    fix-head = "!f(){ git remote set-head ${1:-origin} -a; }; f"
	prebase = rebase -x 'pre-commit run --from-ref HEAD~ --to-ref HEAD'
[http]
	cookiefile = /home/jelte/.gitcookies
[color "diff-highlight"]
	oldNormal = red
	oldHighlight = red 52
	newNormal = green
	newHighlight = green 22
[color "diff"]
	meta = 11
	frag = magenta bold
	commit = yellow
	old = red
	new = green
	whitespace = red reverse
[rebase]
	autosquash = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[rerere]
	enabled = true
# [gpg]
# 	format = ssh
# [commit]
# 	gpgsign = true
# [tag]
# 	gpgsign = true
[credential]
	helper = store
[init]
	defaultBranch = main
[tig "color"]
cursor = black cyan
cursor-blur = black green
title-focus = black blue
title-blur = black blue
[maintenance]
	repo = /home/jelte/opensource/pgbouncer
	repo = /home/jelte/opensource/postgres
	repo = /home/jelte/work/citus
[merge]
	conflictStyle = zdiff3

[sendemail]
    smtpServer = /bin/msmtp

[url "https://github.com/"]
    insteadOf = git@github.com:
[diff]
	colorMoved = default
[submodule]
	recurse = true
    fetchJobs = 0
[fetch]
	parallel = 0
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
